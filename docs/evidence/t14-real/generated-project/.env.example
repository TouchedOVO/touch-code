# Server configuration
PORT=3000
HOST=0.0.0.0

# Admin authentication token (used by question management endpoints).
# Provide a strong value in any real deployment; never commit a real token.
ADMIN_TOKEN=dev-admin-token

# Optional data directory override. Files are JSON and created automatically.
# DATA_DIR=./data
# QUESTIONS_FILE=./data/questions.json
# SCORES_FILE=./data/scores.json
# SEED_QUESTIONS_FILE=./data/seed-questions.json
